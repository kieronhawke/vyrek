# Suth Performance — environment
#
# Every key from docs/build-pack/spec/18 §2, present and blank.
# Copy to .env.local and fill. Never commit a filled version.
#
# NOTE: the build pack names the brand "SUV Athletic" on suvathletic.com.
# That name is superseded (docs/strategy/BRAND-NAME-CORRECTION.md).
# Sending domains below use the confirmed brand. See QUESTIONS.md §4.

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=
NEXT_PUBLIC_APP_URL=
AUTH_SECRET=
ENCRYPTION_KEY=                       # health-field encryption at rest, rotate-able
                                      # generate: openssl rand -base64 32

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_HUB_MONTHLY=
STRIPE_PRICE_HUB_ANNUAL=
STRIPE_PRICE_PROGRAMMING=
STRIPE_PRICE_COACHING=
STRIPE_PRICE_ELITE=

# ── Twilio ───────────────────────────────────────────────────────────
# UK alphanumeric sender ID registration takes ~2 weeks. Start it early.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────────────────
# Transactional sending stays OFF the root domain (HARD-RULES §10).
# Never create a noreply@ address.
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=             # e.g. ben@mail.<confirmed-domain>
EMAIL_FROM_MARKETING=
CONSULTATION_INBOX=

# ── Analytics ────────────────────────────────────────────────────────
# EU host required for GDPR data residency (spec/18 §1).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Google Calendar ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Anthropic ────────────────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Jobs ─────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
CRON_SECRET=

# ── Ops ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Already in use in this repo ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SITE_URL=
ADMIN_EMAILS=

# Google Analytics 4. Unset means no tag is loaded and nothing is sent.
# Set to the property measurement ID (G-XXXXXXXXXX) to start collecting.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
